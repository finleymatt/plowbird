# Copy to server/.env. Leave STRIPE_SECRET_KEY empty to keep simulated payments.
# Test-mode keys: https://dashboard.stripe.com/test/apikeys (Connect must be enabled for driver payouts)
STRIPE_SECRET_KEY=
JWT_SECRET=dev-only-secret-change-me
# Pilot ZIP codes (comma-separated, empty = everywhere) and who can read /api/admin/*. See README.
SERVICE_ZIPS=
ADMIN_EMAILS=
# Cancel orders nobody accepts after this many minutes (default 10).
UNACCEPTED_TIMEOUT_MIN=10
