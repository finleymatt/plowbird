{
  "expo": {
    "name": "Plowbird",
    "slug": "plowbird",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "plowbird",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.plowbird.app",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.plowbird.app",
      "adaptiveIcon": {
        "backgroundColor": "#F26B1D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Plowbird — Snow plowing on demand",
      "themeColor": "#F26B1D"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Plowbird uses your location while you're online so customers can track their plow and you can see nearby jobs."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F26B1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": [
            "merchant.app.plowbird"
          ],
          "enableGooglePay": true
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
