# Copy to app/.env.local. Use the test-mode publishable key that matches the server's STRIPE_SECRET_KEY.
# Leave empty to keep simulated payments.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Support contact on /contact, /terms and /privacy. Defaults to support@plowbird.app; phone is hidden when empty.
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_PHONE=
